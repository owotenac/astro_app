{
  "expo": {
    "name": "astro_app",
    "slug": "astro_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "astroapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Autoriser l'application à utiliser l'appareil photo pour afficher le ciel en Réalité Augmentée.",
        "NSLocationWhenInUseUsageDescription": "Autoriser l'application à utiliser votre position GPS pour calculer l'alignement des objets célestes en temps réel.",
        "NSMotionUsageDescription": "L'accès aux capteurs de mouvements (boussole et gyroscope) est nécessaire pour orienter la carte du ciel en mode Réalité Augmentée."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.HIGH_SAMPLING_RATE_SENSORS",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.owoignier.astro_app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser l'application à utiliser l'appareil photo pour afficher le ciel en Réalité Augmentée."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Autoriser l'application à utiliser votre position pour afficher les étoiles."
        }
      ],
      "expo-sensors",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "b72db247-55ef-43fd-82cc-d1d7deb58f16"
      }
    }
  }
}
